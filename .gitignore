# --- Time Pilot project: never commit ROMs, romsets or derived ROM images ---
/timeplt/
/timeplt.zip
*.rom
/build/
/ref/

# MAME-derived analysis output: state dumps hold video/sprite RAM contents and
# the snapshots are renders of ROM graphics. All of it regenerates in seconds
# from the user's own romset with tools/capture_states.sh.
/artifacts*/

# The bootstrap methodology guide is reference-only, not part of the core
/METHODOLOGY.md

# Loose source copies of the Pocket artwork dropped at the repo root. The
# versions that ship live in pkg/pocket/, named for the platform id.
/timeplt.bin
/icon.bin

